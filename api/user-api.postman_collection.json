{
  "info": {
    "name": "user-service API",
    "description": "REST API сервиса пользователей (порт 8001). Роли, пользователи, профили, адреса, аутентификация. Поля JSON — camelCase, эндпоинты — множественное число, ID в пути.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Список ролей (GET /roles)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/roles",
          "host": ["{{baseUrl}}"],
          "path": ["roles"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Регистрация пользователя (POST /users)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roleId\": 1,\n  \"phone\": \"+79001234567\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"P@ssw0rd123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Ответ содержит id', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.collectionVariables.set('userId', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
