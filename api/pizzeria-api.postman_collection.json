            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Заменить позицию меню (PUT /menuItems/{menuItemId})",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isActive\": true,\n  \"price\": 649.00,\n  \"name\": \"Маргарита\",\n  \"description\": \"Томаты, моцарелла, свежий базилик\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/menuItems/{{menuItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["menuItems", "{{menuItemId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
