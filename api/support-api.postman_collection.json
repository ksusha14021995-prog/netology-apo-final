{
  "info": {
    "name": "support-service API",
    "description": "REST API сервиса поддержки (порт 8004). Тикеты, статусы, переписка. Поля JSON — camelCase, эндпоинты — множественное число, ID в пути.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Создать тикет (POST /supportTickets)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": 1,\n  \"authorId\": 1,\n  \"subject\": \"Заказ опоздал\",\n  \"description\": \"Курьер привёз пиццу на 40 минут позже ожидаемого времени.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/supportTickets",
          "host": ["{{baseUrl}}"],
          "path": ["supportTickets"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Ответ содержит id', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.collectionVariables.set('ticketId', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Тикеты автора (GET /supportTickets?authorId=)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/supportTickets?authorId=1",
          "host": ["{{baseUrl}}"],
          "path": ["supportTickets"],
          "query": [
            { "key": "authorId", "value": "1" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Один тикет (GET /supportTickets/{ticketId})",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/supportTickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["supportTickets", "{{ticketId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Сменить статус тикета (PATCH /supportTickets/{ticketId})",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statusId\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/supportTickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["supportTickets", "{{ticketId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Сообщения тикета (GET /supportTickets/{ticketId}/messages)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/supportTickets/{{ticketId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["supportTickets", "{{ticketId}}", "messages"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Добавить сообщение в тикет (POST /supportTickets/{ticketId}/messages)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorId\": 1,\n  \"body\": \"Прошу пересчитать стоимость доставки, заказ был с задержкой.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/supportTickets/{{ticketId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["supportTickets", "{{ticketId}}", "messages"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Ответ содержит id', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8004" },
    { "key": "token", "value": "" },
    { "key": "ticketId", "value": "1" }
  ]
}
