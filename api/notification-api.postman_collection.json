{
  "info": {
    "name": "notification-service API",
    "description": "REST API сервиса уведомлений (порт 8005). Токены устройств, уведомления, типы уведомлений. Поля JSON — camelCase, эндпоинты — множественное число, ID в пути.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Типы уведомлений (GET /notificationTypes)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notificationTypes",
          "host": ["{{baseUrl}}"],
          "path": ["notificationTypes"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Зарегистрировать токен устройства (POST /deviceTokens)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"isActive\": true,\n  \"platform\": \"ANDROID\",\n  \"token\": \"fcm-d3v1c3-t0k3n-abcdef0123456789\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/deviceTokens",
          "host": ["{{baseUrl}}"],
          "path": ["deviceTokens"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Ответ содержит id', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.collectionVariables.set('deviceTokenId', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Уведомления пользователя (GET /notifications?userId=)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/notifications?userId=1",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"],
          "query": [
            { "key": "userId", "value": "1" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Отметить уведомление прочитанным (PATCH /notifications/{notificationId})",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isRead\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/{{notificationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "{{notificationId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Деактивировать токен устройства (DELETE /deviceTokens/{deviceTokenId})",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/deviceTokens/{{deviceTokenId}}",
          "host": ["{{baseUrl}}"],
          "path": ["deviceTokens", "{{deviceTokenId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8005" },
    { "key": "token", "value": "" },
    { "key": "deviceTokenId", "value": "1" },
    { "key": "notificationId", "value": "1" }
  ]
}
